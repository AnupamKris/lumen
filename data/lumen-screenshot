#!/bin/sh
# Screenshot to ~/Pictures/Screenshots and the clipboard.
#   lumen-screenshot          whole screen
#   lumen-screenshot region   drag to select (needs slurp)
pics=$(xdg-user-dir PICTURES 2>/dev/null)
[ -z "$pics" ] || [ "$pics" = "$HOME" ] && pics="$HOME/Pictures"
dir="$pics/Screenshots"
mkdir -p "$dir"
f="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
if [ "$1" = region ]; then
  geo=$(slurp) || exit 0
  grim -g "$geo" "$f" || exit 1
else
  grim "$f" || exit 1
fi
command -v wl-copy >/dev/null && wl-copy --type image/png < "$f" >/dev/null 2>&1
command -v notify-send >/dev/null && notify-send -a Screenshot -i "$f" "Screenshot saved" "$(basename "$f")"
exit 0
